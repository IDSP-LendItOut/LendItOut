<% layout('layout') %>

<div class="cart-page">

  <div class="cart-items">
    <% cartItems.forEach(item => { %>

      <div class="cart-card">
        <div class="cart-card-top">
          <img src="/<%= item.image %>" alt="<%= item.name %>" />
          <div class="cart-card-info">
            <div class="cart-card-header">
              <h4><%= item.name %></h4>
              <input type="checkbox" class="cart-checkbox" id="select-<%= item.id %>" checked aria-label="Select <%= item.name %>" />
            </div>
            <p class="cart-price"><%= item.priceLabel %></p>
            <div class="cart-qty">
              <button class="decrease-btn" data-id="<%= item.id %>">−</button>
              <span class="quantity" id="quantity-<%= item.id %>"><%= item.quantity %></span>
              <button class="increase-btn" data-id="<%= item.id %>">+</button>
            </div>
          </div>
        </div>

        <div class="cart-card-bottom">
          <div class="cart-tags">
            <% item.contracts.forEach(contract => { %>
              <a href="/termsconditions" class="cart-tag"><i class="fa-solid fa-file-lines"></i> <%= contract %></a>
            <% }) %>
          </div>
          <label class="cart-insurance">
            <input type="checkbox" id="insurance-<%= item.id %>" <%= item.insuranceSelected ? 'checked' : '' %> />
            <span>Add insurance — $<%= item.insurance %></span>
          </label>
        </div>

        <% if (item.canRent || item.canBuy) { %>
          <div class="cart-toggle">
            <% if (item.canRent) { %><button class="cart-toggle-btn active" data-mode="rent">Rent</button><% } %>
            <% if (item.canBuy) { %><button class="cart-toggle-btn" data-mode="buy">Buy</button><% } %>
          </div>
        <% } %>
      </div>

    <% }) %>
  </div>

  <div class="cart-summary">
    <div class="cart-summary-rows">
      <div class="summary-row"><span>Subtotal (Rent)</span><span>$<%= subtotalRent %></span></div>
      <div class="summary-row"><span>Subtotal (Buy)</span><span>$<%= subtotalBuy %></span></div>
      <div class="summary-row"><span>Insurance</span><span>$<%= totalInsurance %></span></div>
      <div class="summary-row"><span>Shipping</span><span>$<%= shipping %></span></div>
      <div class="summary-row total"><strong>Total</strong><strong>$<%= total %></strong></div>
    </div>
    <a href="/cart/checkout" class="cart-checkout-btn">Proceed to Checkout</a>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('.cart-items').addEventListener('click', (e) => {
      if (e.target.classList.contains('cart-toggle-btn')) {
        const toggle = e.target.closest('.cart-toggle');
        toggle.querySelectorAll('.cart-toggle-btn').forEach(btn => btn.classList.remove('active'));
        e.target.classList.add('active');
      }
      if (e.target.classList.contains('increase-btn')) {
        const qty = document.getElementById(`quantity-${e.target.dataset.id}`);
        qty.textContent = parseInt(qty.textContent) + 1;
      }
      if (e.target.classList.contains('decrease-btn')) {
        const qty = document.getElementById(`quantity-${e.target.dataset.id}`);
        if (parseInt(qty.textContent) > 1) qty.textContent = parseInt(qty.textContent) - 1;
      }
    });
  });
</script>