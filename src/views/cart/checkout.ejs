<% layout('layout') %>

<div class="checkout-page">

  <div class="checkout-items">
    <% checkoutItems.forEach(item => { %>
      <div class="checkout-card">
        <img src="<%= item.image %>" alt="<%= item.name %>" />
        <div class="checkout-card-info">
          <p class="checkout-item-name"><%= item.name %></p>
          <p class="checkout-item-desc"><%= item.desc %></p>
          <div class="checkout-item-prices">
            <span><%= item.price %></span>
            <% if (item.insurance) { %><span class="checkout-insurance">+ <%= item.insurance %> ins.</span><% } %>
          </div>
          <p class="checkout-item-total"><%= item.total %></p>
        </div>
        <button class="checkout-remove" aria-label="Remove <%= item.name %>"><i class="fa-solid fa-xmark"></i></button>
      </div>
    <% }) %>
  </div>

  <div class="checkout-section">
    <h3>Shipping Information</h3>
    <p class="checkout-subtitle"><i class="fa-solid fa-truck"></i> Ships within 2 working days</p>

    <form class="checkout-form">
      <label for="full-name">Full Name</label>
      <input type="text" id="full-name" placeholder="Enter your full name" />

      <label for="location">Location</label>
      <select id="location">
        <option value="">Select your location</option>
        <option value="city1">City 1</option>
        <option value="city2">City 2</option>
      </select>

      <label for="delivery-note">Delivery Note</label>
      <textarea id="delivery-note" placeholder="Any special instructions?" rows="3"></textarea>

      <label class="checkout-terms">
        <input type="checkbox" id="terms" checked />
        <span>I accept the <a href="/termsconditions">Terms & Conditions</a></span>
      </label>
    </form>
  </div>

  <div class="checkout-footer">
    <div class="checkout-total-row">
      <span>Total</span>
      <strong><%= total %></strong>
    </div>
    <a href="/cart/checkout/payment" class="checkout-place-btn">Place Order</a>
  </div>

</div>