<% layout('layout') %>

<div class="payment-page">

  <div class="payment-secure">
    <i class="fa-solid fa-lock"></i>
    <span>Secure Payment</span>
  </div>

  <form class="payment-form" id="paymentForm" method="POST" action="/pay">

    <div class="payment-section">
      <p class="payment-section-label">Payment Method</p>
      <div class="payment-methods">
        <label class="payment-method-btn">
          <input type="radio" name="paymentMethod" value="visa" checked />
          <img src="/images/visa.png" alt="Visa" />
          <span>Visa</span>
        </label>
        <label class="payment-method-btn">
          <input type="radio" name="paymentMethod" value="mastercard" />
          <img src="/images/mastercard.png" alt="Mastercard" />
          <span>Mastercard</span>
        </label>
        <label class="payment-method-btn">
          <input type="radio" name="paymentMethod" value="paypal" />
          <img src="/images/paypal.png" alt="PayPal" />
          <span>PayPal</span>
        </label>
        <label class="payment-method-btn">
          <input type="radio" name="paymentMethod" value="applepay" />
          <img src="/images/applepay.png" alt="Apple Pay" />
          <span>Apple Pay</span>
        </label>
      </div>
    </div>

    <div class="payment-section">
      <p class="payment-section-label">Card Details</p>

      <div class="payment-row">
        <div class="payment-input-group">
          <label for="firstName">First Name</label>
          <input type="text" id="firstName" name="firstName" placeholder="John" required autocomplete="cc-given-name" />
        </div>
        <div class="payment-input-group">
          <label for="lastName">Last Name</label>
          <input type="text" id="lastName" name="lastName" placeholder="Doe" required autocomplete="cc-family-name" />
        </div>
      </div>

      <div class="payment-input-group">
        <label for="cardNumber">Card Number</label>
        <div class="payment-input-icon">
          <i class="fa-regular fa-credit-card"></i>
          <input type="text" id="cardNumber" name="cardNumber" placeholder="1234 5678 9012 3456" required inputmode="numeric" autocomplete="cc-number" />
        </div>
      </div>

      <div class="payment-row">
        <div class="payment-input-group">
          <label for="expDate">Expiry</label>
          <input type="text" id="expDate" name="expDate" placeholder="MM/YY" required autocomplete="cc-exp" />
        </div>
        <div class="payment-input-group">
          <label for="cvv">CVV</label>
          <div class="payment-input-icon">
            <i class="fa-solid fa-lock"></i>
            <input type="text" id="cvv" name="cvv" placeholder="123" required inputmode="numeric" autocomplete="cc-csc" />
          </div>
        </div>
      </div>
    </div>

    <div class="payment-footer">
      <div class="payment-total-row">
        <span>Total</span>
        <strong>$330</strong>
      </div>
      <a href="/cart/checkout/payment/pay" class="payment-pay-btn" id="confirmButton">Pay Now</a>
    </div>

  </form>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Payment method toggle highlight
    document.querySelectorAll('.payment-method-btn input').forEach(radio => {
      radio.addEventListener('change', () => {
        document.querySelectorAll('.payment-method-btn').forEach(btn => btn.classList.remove('selected'));
        radio.closest('.payment-method-btn').classList.add('selected');
      });
      if (radio.checked) radio.closest('.payment-method-btn').classList.add('selected');
    });

    // Card number formatting
    document.getElementById('cardNumber').addEventListener('input', (e) => {
      let v = e.target.value.replace(/\D/g, '').substring(0, 16);
      e.target.value = v.replace(/(.{4})/g, '$1 ').trim();
    });

    // Expiry formatting
    document.getElementById('expDate').addEventListener('input', (e) => {
      let v = e.target.value.replace(/\D/g, '').substring(0, 4);
      if (v.length >= 3) v = v.substring(0,2) + '/' + v.substring(2);
      e.target.value = v;
    });
  });
</script>