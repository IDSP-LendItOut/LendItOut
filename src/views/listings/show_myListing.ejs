<% layout('listing-layout') %>

<div id="cartPopup" class="cart-popup">Item added to cart!</div>

<section class="buy-page">
  <%- include("carousel", { listing }) %>

  <div class="action-buttons">
    <% if (currentUser && currentUser.id === listing.user?.id) { %>
    <form action="/listings/my/<%= listing.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this listing?');" enctype="application/x-www-form-urlencoded">
      <input type="hidden" name="_method" value="DELETE" />
      <button class="delete-btn" type="submit">
        <i class="fas fa-trash-alt"></i>
      </button>
    </form>
    <% } %>
    <button class="heart-button" aria-label="Add to favorites"><i class="far fa-heart"></i></button>
    <button class="add-to-cart-button" id="addToCartBtn"><i class="fas fa-cart-plus"></i></button>
    <button class="bookmark-btn" aria-label="Save"><i class="far fa-bookmark"></i></button>
  </div>

  <div class="product-box">

    <h2 class="product-title"><%= listing.title %></h2>

    <% if (listing.salePrice != null && listing.rentalPrice != null) { %>
      <p class="product-price">$<%= listing.salePrice %> or $<%= listing.rentalPrice %>/<%= (listing.rentalDuration || '').toLowerCase() %></p>
    <% } else if (listing.salePrice != null) { %>
      <p class="product-price">$<%= listing.salePrice %></p>
    <% } else if (listing.rentalPrice != null) { %>
      <p class="product-price">$<%= listing.rentalPrice %>/<%= (listing.rentalDuration || '').toLowerCase() %></p>
    <% } %>

    <div class="product-description">
      <strong>Description</strong>
      <p><%= listing.description %></p>
    </div>

    <div class="message-box">
      <p><strong>Send <%= listing.user.name %> a Message</strong></p>
      <div class="message-inner">
        <input type="text" placeholder="Is this available?" />
        <button>Send</button>
      </div>
    </div>

    <div class="condition-box">
      <strong>Condition</strong>
      <span class="badge"><%= listing.condition %></span>
    </div>

    <h4 class="section-label">Seller/Renter Information</h4>
    <div class="seller-box">
      <img src="<%= listing.user.profilePic || 'https://picsum.photos/300/300' %>" class="seller-avatar" onerror="this.src='https://picsum.photos/300/300'" />
      <div class="seller-info">
        <strong><%= listing.user.name %> <i class="fas fa-check-circle verified-icon"></i></strong>
        <small>Joined in <%= joinedYear %></small>
        <div><span class="stars">⭐⭐⭐⭐⭐</span> <small>(13)</small></div>
      </div>
      <span class="details-link">Seller Details</span>
    </div>

    <h4 class="section-label">Location</h4>
    <div class="map-fake">
      <img src="/images/map.png" alt="map" onerror="this.style.display='none'" />
    </div>

    <h4 class="section-label">Delivery Options</h4>
    <div class="info-box">Meet-up</div>

    <h4 class="section-label">Payment Options</h4>
    <div class="info-box">Cash<br />E-transfer</div>

    <% if (listing.reviews && listing.reviews.length > 0) { %>
    <h4 class="section-label">Reviews</h4>
    <div class="review-row">
      <% listing.reviews.forEach(r => { %>
      <div class="review-card">
        <% if (r.reviewer) { %>
        <img src="<%= r.reviewer.profilePic || 'https://picsum.photos/40/40' %>" class="review-avatar" onerror="this.src='https://picsum.photos/40/40'" />
        <div>
          <strong><%= r.reviewer.name %></strong>
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p><%= r.comment %></p>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if (related && related.length > 0) { %>
    <h4 class="section-label">You may also like</h4>
    <div class="related-grid">
      <% related.forEach(r => { %>
      <a href="/listings/<%= r.id %>" class="related-card">
        <img src="<%= r.media && r.media[0] ? r.media[0].url : '/images/fallbacks/lambo.jpg' %>" alt="<%= r.title %>" onerror="this.src='/images/fallbacks/lambo.jpg'" />
        <p class="related-title"><%= r.title %></p>
        <p class="related-price">$<%= r.salePrice != null ? r.salePrice : r.rentalPrice %></p>
        <small><%= r.salePrice != null ? "Purchase available" : "Rent available" %></small>
      </a>
      <% }) %>
    </div>
    <% } %>

  </div>
</section>

<script src="/scripts/addToCart.js"></script>
