      </div>
      <div class="notif-content">
        <p class="notif-title">Return due in 2 days</p>
        <p class="notif-desc">Canon EOS R5 — please prepare for drop-off</p>
        <p class="notif-time">6h ago</p>
      </div>
      <span class="notif-dot"></span>
    </div>

    <div class="notif-item unread">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/bike/80/80" alt="item">
        <span class="notif-badge"><i class="fa-solid fa-check"></i></span>
      </div>
      <div class="notif-content">
        <p class="notif-title">Payment processed</p>
        <p class="notif-desc">Mountain Bike rental — payment successful</p>
        <p class="notif-time">8h ago</p>
      </div>
      <span class="notif-dot"></span>
    </div>

    <p class="notif-day-label">Yesterday</p>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/speaker/80/80" alt="item">
        <span class="notif-badge"><i class="fa-solid fa-bell"></i></span>
      </div>
      <div class="notif-content">
        <p class="notif-title">Back in stock</p>
        <p class="notif-desc">JBL Go 4 is available again — grab yours now</p>
        <p class="notif-time">1d ago</p>
      </div>
    </div>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/console/80/80" alt="item">
        <span class="notif-badge"><i class="fa-solid fa-truck"></i></span>
      </div>
      <div class="notif-content">
        <p class="notif-title">Order shipped</p>
        <p class="notif-desc">PlayStation 5 — delivery in 3–5 business days</p>
        <p class="notif-time">1d ago</p>
