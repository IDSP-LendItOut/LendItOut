      </div>
      <div class="notif-content">
        <p class="notif-title">Upcoming payment due</p>
        <p class="notif-desc">Item #453432 — 3 Bed, 2 Bath house — $2,500/month</p>
        <p class="notif-time">2h ago</p>
      </div>
      <span class="notif-dot"></span>
    </div>

    <div class="notif-item unread">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/laptop/80/80" alt="item">
        <span class="notif-badge"><i class="fa-solid fa-check"></i></span>
      </div>
      <div class="notif-content">
        <p class="notif-title">Rental confirmed</p>
        <p class="notif-desc">MacBook Pro 16" — pickup scheduled for tomorrow</p>
        <p class="notif-time">4h ago</p>
      </div>
      <span class="notif-dot"></span>
    </div>

    <div class="notif-item unread">
      <div class="notif-icon-wrap">
