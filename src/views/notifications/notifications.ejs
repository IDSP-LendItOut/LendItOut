        <p class="notif-title">3 Bed, 2 Bath House</p>
        <p class="notif-desc">$2,500 / month</p>
      </div>
      <i class="fa-solid fa-chevron-right notif-arrow"></i>
    </div>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/speaker/80/80" alt="item">
      </div>
      <div class="notif-content">
        <p class="notif-title">JBL Go 4 Speaker</p>
        <p class="notif-desc">$50</p>
      </div>
      <i class="fa-solid fa-chevron-right notif-arrow"></i>
    </div>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/camera/80/80" alt="item">
      </div>
      <div class="notif-content">
        <p class="notif-title">Canon EOS R5 Camera</p>
        <p class="notif-desc">$150 / day</p>
      </div>
      <i class="fa-solid fa-chevron-right notif-arrow"></i>
    </div>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/bike/80/80" alt="item">
      </div>
      <div class="notif-content">
        <p class="notif-title">Mountain Bike</p>
        <p class="notif-desc">$20 / day</p>
      </div>
      <i class="fa-solid fa-chevron-right notif-arrow"></i>
    </div>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/console/80/80" alt="item">
      </div>
      <div class="notif-content">
        <p class="notif-title">PlayStation 5</p>
        <p class="notif-desc">$30 / day</p>
      </div>
      <i class="fa-solid fa-chevron-right notif-arrow"></i>
    </div>

  </div>

</div>

<script>
  function showSection(sectionId) {
    document.getElementById('notifications').style.display = 'none';
    document.getElementById('listings').style.display = 'none';
    document.getElementById('notifications-tab').classList.remove('active');
    document.getElementById('listings-tab').classList.remove('active');
    document.getElementById(sectionId).style.display = 'block';
    document.getElementById(sectionId + '-tab').classList.add('active');
  }
</script>