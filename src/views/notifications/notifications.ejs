    </div>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/furniture/80/80" alt="item">
        <span class="notif-badge"><i class="fa-solid fa-rotate-left"></i></span>
      </div>
      <div class="notif-content">
        <p class="notif-title">Return complete</p>
        <p class="notif-desc">Dining table set returned successfully</p>
        <p class="notif-time">1d ago</p>
      </div>
    </div>

    <div class="notif-item">
      <div class="notif-icon-wrap">
        <img src="https://picsum.photos/seed/headphones/80/80" alt="item">
        <span class="notif-badge"><i class="fa-solid fa-check"></i></span>
      </div>
      <div class="notif-content">
        <p class="notif-title">Payment received</p>
        <p class="notif-desc">Bose Noise Cancelling Headphones 700</p>
        <p class="notif-time">1d ago</p>
      </div>
