<% layout('layout') %>

<div class="notif-page">

  <div class="notif-tabs">
    <button id="notifications-tab" class="notif-tab active" onclick="showSection('notifications')">Notifications</button>
    <button id="listings-tab" class="notif-tab" onclick="showSection('listings')">Listings</button>
  </div>

  <div id="notifications" class="notif-section">

    <p class="notif-day-label">Today</p>

    <div class="notif-item unread">
